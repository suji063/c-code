#include <stdlib.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int largestRectangleArea(int* heights, int heightsSize) {
    // Allocate space for the stack to hold indices
    int* stack = (int*)malloc((heightsSize + 1) * sizeof(int));
    int top = -1;
    int maxArea = 0;

    for (int i = 0; i <= heightsSize; ++i) {
        // Use 0 as a sentinel height at the end to flush out remaining stack elements
        int currentHeight = (i == heightsSize) ? 0 : heights[i];

        // Maintain monotonic increasing order in stack
        while (top != -1 && heights[stack[top]] >= currentHeight) {
            int h = heights[stack[top--]]; // Height of the popped bar
            
            // Width is determined by current index and the index below the popped one
            int w = (top == -1) ? i : (i - stack[top] - 1);
            
            int area = h * w;
            maxArea = MAX(maxArea, area);
        }
        
        // Push the current index onto the stack
        stack[++top] = i;
    }

    free(stack);
    return maxArea;
}
